# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# Flask应用配置
FLASK_ENV=development
FLASK_PORT=5000

# Dify配置
DIFY_BASE_URL=http://your-dify-server/v1

# 安全密钥 (生产环境请使用随机生成的强密钥)
SECRET_KEY=your-super-secret-key-here-change-me-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-me-in-production

# Redis配置
REDIS_PASSWORD=your-redis-password-here

# 日志配置
LOG_LEVEL=INFO

# 可选：Redis Commander访问
REDIS_COMMANDER_PORT=8081
