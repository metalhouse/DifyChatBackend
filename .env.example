# DifyChatBackend 环境配置示例
# 复制此文件为 .env 并根据你的环境调整配置值

# =============================================================================
# 应用环境配置
# =============================================================================
# 应用运行环境: development, production, testing
FLASK_ENV=development

# =============================================================================
# Dify API 配置
# =============================================================================
# Dify API 基础URL（必填）
DIFY_BASE_URL=http://192.168.1.68/v1

# 默认Dify API密钥（可选，如果agents.json中没有配置）
DIFY_API_KEY=your-default-dify-api-key

# Dify API超时时间（秒）
DIFY_TIMEOUT=30

# Dify API最大重试次数
DIFY_MAX_RETRIES=3

# =============================================================================
# 安全配置
# =============================================================================
# Flask密钥（生产环境必须设置为随机字符串）
SECRET_KEY=your-secret-key-change-in-production

# JWT密钥（如未设置则使用SECRET_KEY）
JWT_SECRET_KEY=your-jwt-secret-key

# JWT访问令牌过期时间（秒，默认1小时）
JWT_ACCESS_TOKEN_EXPIRES=3600

# JWT刷新令牌过期时间（秒，默认7天）
JWT_REFRESH_TOKEN_EXPIRES=604800

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间（秒，默认5分钟）
LOCKOUT_DURATION=300

# 密码哈希方法
PASSWORD_HASH_METHOD=pbkdf2:sha256

# =============================================================================
# 服务器配置
# =============================================================================
# 服务器监听地址
FLASK_HOST=0.0.0.0

# 服务器端口
FLASK_PORT=5000

# 调试模式（生产环境必须设为false）
FLASK_DEBUG=false

# 多线程支持
FLASK_THREADED=true

# 跨域支持
CORS_ENABLED=true

# 允许的跨域来源
CORS_ORIGINS=*

# =============================================================================
# 数据库配置
# =============================================================================
# 数据存储目录
DATA_DIR=./data

# 用户数据文件路径
USERS_FILE=./users.json

# 智能体配置文件路径
AGENTS_FILE=./agents.json

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志目录
LOG_DIR=./logs

# 日志文件名
LOG_FILE=app.log

# 单个日志文件最大大小（字节）
LOG_MAX_FILE_SIZE=10485760

# 保留的日志文件数量
LOG_BACKUP_COUNT=5

# 启用控制台日志
LOG_ENABLE_CONSOLE=true

# 启用文件日志
LOG_ENABLE_FILE=true

# 启用Syslog日志
LOG_ENABLE_SYSLOG=false

# Syslog服务器地址
LOG_SYSLOG_HOST=localhost

# Syslog服务器端口
LOG_SYSLOG_PORT=514

# =============================================================================
# Redis配置（用于缓存和会话管理）
# =============================================================================
# 启用Redis
REDIS_ENABLED=false

# Redis服务器地址
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis数据库编号（主应用使用0，聊天室使用1）
REDIS_DB=0

# Redis密码（如果有）
REDIS_PASSWORD=

# Redis响应解码
REDIS_DECODE_RESPONSES=true

# Redis连接超时时间（秒）
REDIS_SOCKET_TIMEOUT=5

# Redis连接池最大连接数
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# MariaDB 数据库配置（聊天室系统）
# =============================================================================
# 是否启用MariaDB聊天室数据库
MARIADB_ENABLED=false

# MariaDB数据库服务器地址
MARIADB_HOST=localhost

# MariaDB数据库端口（默认3306）
MARIADB_PORT=3306

# MariaDB数据库名称
MARIADB_DATABASE=chatroom_db

# MariaDB数据库用户名
MARIADB_USERNAME=chatroom_user

# MariaDB数据库密码（请修改为安全的密码）
MARIADB_PASSWORD=your_secure_password_here

# MariaDB字符集
MARIADB_CHARSET=utf8mb4

# MariaDB连接池大小
MARIADB_POOL_SIZE=10

# MariaDB最大溢出连接数
MARIADB_MAX_OVERFLOW=20

# MariaDB连接池超时时间（秒）
MARIADB_POOL_TIMEOUT=30

# MariaDB连接回收时间（秒）
MARIADB_POOL_RECYCLE=3600

# 是否禁用MariaDB SSL连接
MARIADB_SSL_DISABLED=true

# =============================================================================
# 聊天室系统配置
# =============================================================================
# 是否启用聊天室系统
CHATROOM_ENABLED=false

# 聊天室默认最大用户数
CHATROOM_MAX_USERS_DEFAULT=100

# 消息最大长度
CHATROOM_MESSAGE_MAX_LENGTH=4000

# 历史消息限制
CHATROOM_HISTORY_LIMIT=50

# 消息发送频率限制（每分钟）
CHATROOM_MESSAGE_RATE_LIMIT=10

# 聊天室Redis数据库编号（与主应用分离）
CHATROOM_REDIS_DB=1

# =============================================================================
# WebSocket 配置（聊天室系统）
# =============================================================================
# SocketIO异步模式: threading, eventlet, gevent
SOCKETIO_ASYNC_MODE=threading

# SocketIO ping超时时间（秒）
SOCKETIO_PING_TIMEOUT=60

# SocketIO ping间隔（秒）
SOCKETIO_PING_INTERVAL=25

# SocketIO跨域允许的来源
SOCKETIO_CORS_ALLOWED_ORIGINS=*

# SocketIO最大HTTP缓冲区大小
SOCKETIO_MAX_HTTP_BUFFER_SIZE=1000000
