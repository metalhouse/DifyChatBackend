				{
					"name": "获取系统信息",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/info",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "info"]
						},
						"description": "获取系统基本信息（公开访问）"
					},
					"response": []
				}
			]
		},
		{
			"name": "Dify标准API",
			"item": [
				{
					"name": "聊天消息 (Dify标准)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"inputs\": {},\n  \"query\": \"你好，请介绍一下自己\",\n  \"response_mode\": \"blocking\",\n  \"conversation_id\": \"{{conversationId}}\",\n  \"user\": \"{{username}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/chat-messages",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "chat-messages"]
						},
						"description": "Dify标准聊天消息接口"
					},
					"response": []
				},
				{
					"name": "消息反馈",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": \"like\",\n  \"user\": \"{{username}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/messages/{{messageId}}/feedbacks",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "messages", "{{messageId}}", "feedbacks"]
						},
						"description": "对消息进行反馈评价"
					},
					"response": []
				},
				{
					"name": "获取建议问题",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/messages/{{messageId}}/suggested?user={{username}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "messages", "{{messageId}}", "suggested"],
							"query": [
								{
									"key": "user",
									"value": "{{username}}",
									"description": "用户名"
								}
							]
						},
						"description": "获取消息的建议问题"
					},
					"response": []
				}
			]
		}
