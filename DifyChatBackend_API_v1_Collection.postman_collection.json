{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "DifyChatBackend API v1 - 标准化版本",
		"description": "DifyChatBackend API路由重构后的完整测试集合\n\n特性:\n- 统一的 /api/v1/ 路径\n- 标准化响应格式\n- JWT认证支持\n- 完整的错误处理\n- 请求验证\n- 缓存管理",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "认证管理",
			"item": [
				{
					"name": "用户登录",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\",\n  \"remember_me\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "用户登录接口，返回JWT访问令牌和刷新令牌"
					},
					"response": []
				},
				{
					"name": "刷新令牌",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "使用刷新令牌获取新的访问令牌"
					},
					"response": []
				},
				{
					"name": "获取当前用户信息",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "获取当前登录用户的信息"
					},
					"response": []
				},
				{
					"name": "用户登出",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "用户登出，撤销当前访问令牌"
					},
					"response": []
				}
			]
		},
		{
			"name": "聊天功能",
			"item": [
				{
					"name": "获取智能体列表",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/chat/agents?use_cache=true&search=&category=",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "chat", "agents"],
							"query": [
								{
									"key": "use_cache",
									"value": "true",
									"description": "是否使用缓存"
								},
								{
									"key": "search",
									"value": "",
									"description": "搜索关键词"
								},
								{
									"key": "category",
									"value": "",
									"description": "智能体分类"
								}
							]
						},
						"description": "获取用户可访问的智能体列表"
					},
					"response": []
				},
				{
					"name": "获取对话列表",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/chat/conversations?agent_id={{agentId}}&limit=20&use_cache=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "chat", "conversations"],
							"query": [
								{
									"key": "agent_id",
									"value": "{{agentId}}",
									"description": "智能体ID"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "返回数量限制"
								},
								{
									"key": "use_cache",
									"value": "true",
									"description": "是否使用缓存"
								}
							]
						},
						"description": "获取指定智能体的对话列表"
					},
					"response": []
				},
				{
					"name": "创建新对话",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"agent_id\": \"{{agentId}}\",\n  \"name\": \"新对话\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/chat/conversations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "chat", "conversations"]
						},
						"description": "创建新的对话会话"
					},
					"response": []
				},
				{
					"name": "发送聊天消息",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"agent_id\": \"{{agentId}}\",\n  \"conversation_id\": \"{{conversationId}}\",\n  \"message\": \"你好，请介绍一下自己\",\n  \"stream\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/chat/messages",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "chat", "messages"]
						},
						"description": "发送聊天消息到指定对话"
					},
					"response": []
				}
			]
		},
		{
			"name": "缓存管理",
			"item": [
				{
					"name": "缓存健康检查",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/cache/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cache", "health"]
						},
						"description": "检查缓存系统健康状态"
					},
					"response": []
				},
				{
					"name": "获取缓存统计",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/cache/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cache", "stats"]
						},
						"description": "获取缓存系统统计信息"
					},
					"response": []
				},
				{
					"name": "预热缓存",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cache_types\": [\"agents\", \"conversations\", \"permissions\"],\n  \"force\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cache/preload",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cache", "preload"]
						},
						"description": "预热指定类型的缓存"
					},
					"response": []
				},
				{
					"name": "刷新缓存",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cache_type\": \"agent_config\",\n  \"agent_id\": \"{{agentId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cache/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cache", "refresh"]
						},
						"description": "刷新特定的缓存项"
					},
					"response": []
				},
				{
					"name": "清除缓存",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cache_pattern\": \"user:*\",\n  \"confirm\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cache/invalidate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cache", "invalidate"]
						},
						"description": "清除匹配模式的缓存项"
					},
					"response": []
				}
			]
		},
		{
			"name": "用户管理",
			"item": [
				{
