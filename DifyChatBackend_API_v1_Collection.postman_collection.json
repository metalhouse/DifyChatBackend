								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/user/permissions?use_cache=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "user", "permissions"],
							"query": [
								{
									"key": "use_cache",
									"value": "true",
									"description": "是否使用缓存"
								}
							]
						},
						"description": "获取当前用户的权限信息"
					},
					"response": []
				}
			]
		},
