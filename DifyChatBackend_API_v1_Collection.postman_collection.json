						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/agent/config?agent_id={{agentId}}&use_cache=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "agent", "config"],
							"query": [
								{
									"key": "agent_id",
									"value": "{{agentId}}",
									"description": "智能体ID"
								},
								{
									"key": "use_cache",
									"value": "true",
									"description": "是否使用缓存"
								}
							]
						},
						"description": "获取指定智能体的配置信息"
					},
					"response": []
				}
			]
		},
