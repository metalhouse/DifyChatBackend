  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 设置请求ID（用于追踪）",
          "pm.request.headers.add({",
          "    key: 'X-Request-ID',",
          "    value: pm.variables.replaceIn('{{$randomUUID}}'),",
          "});",
          "",
          "// 设置时间戳",
          "pm.request.headers.add({",
          "    key: 'X-Request-Timestamp',",
          "    value: new Date().toISOString(),",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 全局响应格式验证",
          "pm.test('响应包含必需的标准化字段', function () {",
          "    if (pm.response.code !== 0) {  // 跳过无响应的情况",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('success');",
          "        pm.expect(jsonData).to.have.property('request_id');",
          "        pm.expect(jsonData).to.have.property('timestamp');",
          "        ",
          "        if (jsonData.success) {",
          "            pm.expect(jsonData).to.have.property('message');",
          "            pm.expect(jsonData).to.have.property('data');",
          "        } else {",
          "            pm.expect(jsonData).to.have.property('error_code');",
          "            pm.expect(jsonData).to.have.property('message');",
          "        }",
          "    }",
          "});",
          "",
          "// 自动刷新令牌检查",
          "const newToken = pm.response.headers.get('X-New-Access-Token');",
          "if (newToken) {",
          "    pm.collectionVariables.set('access_token', newToken);",
          "    console.log('访问令牌已自动刷新');",
          "}"
        ]
      }
    }
  ]
}
