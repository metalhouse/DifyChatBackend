{
  "info": {
    "name": "DifyChatBackend 新增API端点测试",
    "description": "测试8个新增的Dify API功能端点",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 如果没有token，先执行登录",
          "if (!pm.collectionVariables.get('access_token')) {",
          "    console.log('需要先登录获取token');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_message_id",
      "value": "test_message_123",
      "type": "string"
    },
    {
      "key": "test_conversation_id",
      "value": "test_conversation_123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. 登录获取Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('登录成功', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('响应包含token', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('access_token');",
              "    ",
              "    // 保存token到环境变量",
              "    pm.collectionVariables.set('access_token', jsonData.data.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"testpass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "1. 消息反馈 - 点赞",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('消息反馈API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"rating\": \"like\",\n    \"content\": \"这个回答很有帮助！\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/messages/{{test_message_id}}/feedbacks",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "messages", "{{test_message_id}}", "feedbacks"]
        }
      }
    },
    {
      "name": "1. 消息反馈 - 点踩",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('消息反馈API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"rating\": \"dislike\",\n    \"content\": \"回答不够准确，需要改进。\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/messages/{{test_message_id}}/feedbacks",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "messages", "{{test_message_id}}", "feedbacks"]
        }
      }
    },
    {
      "name": "2. 获取建议问题",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('建议问题API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "    if (jsonData.success) {",
              "        pm.expect(jsonData).to.have.property('data');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/messages/{{test_message_id}}/suggested-questions",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "messages", "{{test_message_id}}", "suggested-questions"]
        }
      }
    },
    {
      "name": "3. 对话重命名 - 手动命名",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('对话重命名API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"我的新对话标题\",\n    \"auto_generate\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{test_conversation_id}}/name",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "conversations", "{{test_conversation_id}}", "name"]
        }
      }
    },
    {
      "name": "3. 对话重命名 - 自动生成",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('对话重命名API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"auto_generate\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{test_conversation_id}}/name",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "conversations", "{{test_conversation_id}}", "name"]
        }
      }
    },
    {
      "name": "4. 获取历史消息",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('历史消息API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "    if (jsonData.success) {",
              "        pm.expect(jsonData).to.have.property('data');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{test_conversation_id}}/messages?limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "conversations", "{{test_conversation_id}}", "messages"],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "5. 文字转语音",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('文字转语音API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "// 检查是否返回音频内容或JSON响应",
              "pm.test('响应类型正确', function () {",
              "    const contentType = pm.response.headers.get('Content-Type');",
              "    pm.expect(contentType).to.satisfy(type => ",
              "        type.includes('audio/') || type.includes('application/json')",
              "    );",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"text\": \"这是一段测试文字转语音的内容，请将其转换为音频。\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/text-to-audio",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "text-to-audio"]
        }
      }
    },
    {
      "name": "6. 获取应用信息",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('应用信息API响应正常', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "    if (jsonData.success) {",
              "        pm.expect(jsonData).to.have.property('data');",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/info",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "info"]
        }
      }
    },
    {
      "name": "7. 语音转文字",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('语音转文字API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "请选择一个音频文件 (mp3, wav, m4a等格式)"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/audio-to-text",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "audio-to-text"]
        }
      }
    },
    {
      "name": "8. 对话删除 (最后执行)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('对话删除API可访问', function () {",
              "    pm.response.to.be.ok;",
              "});",
              "",
              "pm.test('响应格式正确', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/conversations/{{test_conversation_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "conversations", "{{test_conversation_id}}"]
        }
      }
    }
  ]
}
